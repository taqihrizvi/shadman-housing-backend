PORT=5000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/shadman_housing?schema=public"
JWT_SECRET=your-secret-key-change-this-in-production-use-64-char-random-string
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production-use-64-char-random-string
JWT_EXPIRE=1h
FRONTEND_URL=http://localhost:8080
NODE_ENV=development

# Security Notes:
# 1. NEVER commit the actual .env file to version control
# 2. Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 3. Change all default passwords
# 4. Enable HTTPS in production
# 5. Set NODE_ENV=production in production
